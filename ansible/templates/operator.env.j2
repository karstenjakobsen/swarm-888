# Managed by Ansible. Persistent application data is stored outside the checkout.
{% set password_quote = "'" if "'" not in operator_admin_password else '`' %}
ADMIN_PASSWORD={{ password_quote }}{{ operator_admin_password }}{{ password_quote }}
APP_STATE_DIR={{ operator_state_dir }}
APP_PROJECTS_DIR={{ operator_projects_dir }}
APP_CONTROLLER_UID={{ operator_account.uid }}
APP_HOST={{ operator_host }}
APP_PORT={{ operator_port }}
APP_ORIGINS={{ operator_origins | join(',') }}
APP_SECURE_COOKIE={{ operator_secure_cookie | bool | lower }}
APP_REQUIRE_ROOT_WORKER=false
APP_IMPROVEMENT_ENABLED={{ operator_improvement_enabled | bool | lower }}
