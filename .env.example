# Controller and frontend must run as a normal user. No default password exists.
ADMIN_PASSWORD=
# Absolute durable directory, outside this checkout/build output. Default shown:
# APP_STATE_DIR=/home/YOUR_USER/.local/share/vps-ai-operator
APP_HOST=127.0.0.1
# The broker launches agent commands as a separate non-root identity.
APP_PROTECT_OPERATOR=true
# Create this dedicated account using README; its numeric IDs are resolved automatically.
APP_EXECUTION_USER=vps-ai-projects
# Alternatively, remove APP_EXECUTION_USER and set both numeric IDs:
# APP_EXECUTION_UID=999
# APP_EXECUTION_GID=999
APP_PROJECTS_DIR=/srv/vps-ai-projects
APP_EXECUTION_HOME=/var/lib/vps-ai-executor
APP_PORT=3001
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For a single exact origin, APP_ORIGIN is also supported when APP_ORIGINS is unset.
APP_SECURE_COOKIE=false
# CODEX_BIN defaults to this checkout's pinned node_modules/.bin/codex
# CODEX_MODEL=an-available-model-id
# Privileged broker: set to the normal controller user's numeric UID (id -u).
# APP_CONTROLLER_UID=1000
# Improvement runs have a distinct record, timeout, and bounded tool-turn budget.
APP_IMPROVEMENT_ENABLED=true
APP_IMPROVEMENT_TIMEOUT_MS=90000
APP_IMPROVEMENT_MAX_TURNS=3
# Authenticate model access with npm run auth (stdin) into the dedicated profile.
